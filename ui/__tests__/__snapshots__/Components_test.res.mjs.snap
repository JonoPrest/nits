exports[`ReviewHeader > renders a minimal closed header and a keymap-described settings menu > minimal closed review header 1`] = `"<header aria-label="review targets" class="review-header"><div aria-label="Review location" class="review-identity"><button class="btn btn-ghost" type="button">⌂ hacks</button><span class="daemon-context">Daemon context unavailable</span><span class="active-repository">2 repositories in this review</span></div><div class="review-header-main"><span class="review-header-title">Keyboard-first client core</span><span class="review-header-target"><span class="review-header-repo">nits:</span><span class="review-header-side-label">Base</span><button class="btn btn-ghost" type="button">main ▾</button><span aria-hidden="true" class="review-header-arrow">→</span><span class="review-header-side-label">Head</span><button class="btn btn-ghost" type="button">worktree ▾</button></span><span class="review-header-target"><span class="review-header-repo">envio:</span><span class="review-header-side-label">Base</span><button class="btn btn-ghost" type="button">commit:1f202122232425262728292a2b2c2d2e2f303132 ▾</button><span aria-hidden="true" class="review-header-arrow">→</span><span class="review-header-side-label">Head</span><button class="btn btn-ghost" type="button">head ▾</button></span><label class="chip-check" data-active="true"><input type="checkbox" checked="">+ working tree</label></div><div class="review-header-toggles"><div class="diff-settings"><button aria-label="Diff settings" aria-expanded="false" aria-haspopup="menu" aria-controls="diff-settings-menu" class="btn btn-icon" type="button"><span aria-hidden="true">⚙</span></button></div><span class="header-totals">0 files · <span class="stat-add">+0</span> <span class="stat-del">−0</span></span><span class="conn-dot conn-disconnected" title="disconnected"></span></div></header>"`;

